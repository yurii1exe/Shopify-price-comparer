# Copy to .env and fill in. Never commit the real .env.

# --- Required ---------------------------------------------------------------

# Shopify store subdomain, i.e. the "acme" in acme.myshopify.com
SHOPIFY_STORE_NAME=example-store

# Shopify Admin API access token (shpat_...)
SHOPIFY_ACCESS_TOKEN=example-admin-api-access-token

# MongoDB connection string. Matches the docker-compose service.
MONGODB_URI=mongodb://localhost:27017/price-comparer

# --- Optional ---------------------------------------------------------------

# Port the Express server listens on. Default 3000.
PORT=3000

# Shopify Admin API version. Default 2024-10.
SHOPIFY_API_VERSION=2024-10

# Shared secret shown when the webhook subscription is created.
# Without it, /webhooks/shopify is not mounted at all.
SHOPIFY_WEBHOOK_SECRET=

# eBay Browse API application credentials.
# Without both, the eBay source is not registered and /api/pricing/compare
# answers 503 rather than pretending to have prices.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_CURRENCY=USD

# Shared secret the /api/pricing routes require in the X-Api-Key header.
# Without it those routes answer 503 rather than repricing for anyone who can
# reach the port. Generate one with: openssl rand -hex 32
PRICING_API_KEY=

# Largest single price move, as a percentage of the current price.
# A product whose computed price is further than this is skipped and reported.
MAX_PRICE_CHANGE_PERCENT=20
